#!/usr/bin/env bash
set -e

echo "Running pre-commit playbook checks..."

# 1. Check link & LaTeX integrity
python3 tools/linting/check_playbook.py

# 2. Check frontmatter schema and Constitution/README version parity
python3 tools/linting/check_frontmatter.py

# 3. Check every worked example in the docs still reproduces from the models
python3 models/test_tcg_models.py

# 4. Check the axiom figures still match the equations that generate them
python3 models/make_figures.py --check

# 5. Check Vale style rules if vale is installed
if command -v vale &> /dev/null; then
    vale .
else
    echo "Warning: vale not found on PATH. Skipping Vale linting."
fi

echo "All pre-commit checks passed."
